# ~/.config/zsh/.zshrc — Kris' interactive zsh config (ZDOTDIR = ~/.config/zsh).
#
# Deployed by the stow tree (home/zsh) via each OS's dotfiles-stow module
# (modules/darwin/dotfiles-stow.nix, modules/nixos/dotfiles-stow.nix). The
# system /etc/zshenv sets ZDOTDIR here (each OS's zsh module), and /etc/zshrc
# provides compinit, autosuggestions, and syntax highlighting. This file runs
# last, so it gets the final word on aliases and the prompt.
#
# Core shell behavior (history, options, keymap, PATH) lives here; everything
# else is broken out into sibling files sourced below. Source order matters —
# see the comment on each source line.

## History — the system /etc/zshrc already set HISTSIZE/SAVEHIST/HISTFILE
## (~/.local/state/zsh/history); raise the limits here.
HISTSIZE=100000
# shellcheck disable=SC2034 # SAVEHIST is a zsh parameter; shellcheck only knows bash
SAVEHIST=10000000

## Options
setopt interactivecomments # allow comments on the command line
setopt AUTO_CD             # bare `dir/` cd's into it
setopt histignorespace     # space-prefixed commands are excluded from history

## Editor — used by edit-command-line below (EDITOR/MANPAGER are set
## system-wide by each OS's neovim module).
export VISUAL=nvim

## Hermes: prefer the resize-aware TUI in Herdr panes only. Keep an explicit
## HERMES_TUI value; `hermes --cli` still overrides this per invocation.
if [[ -n ${HC_TERMINAL_ID-} || ${HERDR_ENV-} == 1 ]]; then
  export HERMES_TUI=${HERMES_TUI-1}
fi

## Vi-mode + edit-command-line: press `v` in command mode to edit the current
## line in $VISUAL.
set -o vi
autoload -U edit-command-line
zle -N edit-command-line
bindkey -M vicmd v edit-command-line

## Aliases and their completions.
source "$ZDOTDIR/aliases.zsh"

## `y` — yazi wrapper that cd's into yazi's last dir (pure POSIX sh, so other
## POSIX shells can share the same file).
source "$ZDOTDIR/yazi.sh"

## Opt-in helper functions (stderred).
source "$ZDOTDIR/functions.zsh"

## `gh` wrapper for out-of-order terminal-query replies under `devenv shell`
## (see the file's header). Probes the live terminal once per shell; no-op
## cost outside a misbehaving pty relay.
source "$ZDOTDIR/devenv-gh.zsh"

## Graphical-session variables (WAYLAND_DISPLAY, …) re-synced from the
## systemd user manager when stale. herdr panes start without them; see the
## file's header. Linux-only, self-guarded. The [ -f ] guard covers a host
## that pulled this .zshrc before its next rebuild restowed the new link.
[ -f "$ZDOTDIR/session-env.zsh" ] && source "$ZDOTDIR/session-env.zsh"

## Darwin-specific setup — self-guarded, no-op elsewhere. Must precede the
## PATH export below (brew shellenv prepends its own paths).
source "$ZDOTDIR/darwin.zsh"

## PATH: bun globals and user-local bins. Darwin's persistent system-profile
## fallback lives in /etc/zshenv so noninteractive SSH commands get it too.
export PATH="$HOME/.bun/bin:$HOME/.local/bin:$PATH"

## Third-party tool hooks: starship prompt, zoxide, direnv, fzf, atuin. Must
## follow the PATH export above so the tools are findable.
source "$ZDOTDIR/integrations.zsh"

## claude-account-selector wrapper — generated by its darwin module on
## hosts that enable it; absent elsewhere.
[ -f "$ZDOTDIR/claude-account-selector.zsh" ] && source "$ZDOTDIR/claude-account-selector.zsh"

# bun completions
[ -s "/private/tmp/claude-501/-Users-k-src-perforce-cto-p4c-portal/ff50474d-9193-4285-86bd-4c5616cfdaec/scratchpad/bun141/_bun" ] && source "/private/tmp/claude-501/-Users-k-src-perforce-cto-p4c-portal/ff50474d-9193-4285-86bd-4c5616cfdaec/scratchpad/bun141/_bun"
