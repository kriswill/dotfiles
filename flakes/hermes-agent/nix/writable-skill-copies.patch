     shutil.move(str(src), str(dest))
 
 
-def _copy_dir(src: Path, dest: Path) -> None:
+def _make_skill_copy_writable(path: Path) -> None:
+    """Add owner access to a copied tree, never following symlinks.
+
+    copytree preserves immutable package modes (e.g. Nix's 0555 directories).
+    Keep all other mode bits, including executable scripts, and touch only the
+    destination after copytree has finished applying source metadata.
+    """
+    mode = path.lstat().st_mode
+    if stat.S_ISLNK(mode):
+        return
+    if stat.S_ISDIR(mode):
+        path.chmod(stat.S_IMODE(mode) | stat.S_IRWXU, follow_symlinks=False)
+        for child in path.iterdir():
+            _make_skill_copy_writable(child)
+    elif stat.S_ISREG(mode):
+        path.chmod(stat.S_IMODE(mode) | stat.S_IRUSR | stat.S_IWUSR, follow_symlinks=False)
+
+
+def _copy_dir(src: Path, dest: Path, **kwargs) -> None:
     dest.parent.mkdir(parents=True, exist_ok=True)
-    shutil.copytree(src, dest, ignore=_ignore_runtime_cache)
+    shutil.copytree(src, dest, symlinks=True, ignore=_ignore_runtime_cache, **kwargs)
+    _make_skill_copy_writable(dest)
 
 
