+++ b/tools/computer_use/cua_backend_external.py
@@ -0,0 +1,73 @@
+"""Ours: non-owning transport for a user-managed, externally bounded CuaDriver.
+
+The external runtime owns its launch-time manifest and lifetime. This adapter
+must never inherit the private daemon's launch/stop/kill/unlink implementation.
+"""
+from __future__ import annotations
+
+import os
+import stat
+import subprocess
+
+from tools.computer_use import cua_backend_driver as _driver
+
+
+def _cb():
+    from tools.computer_use import cua_backend
+    return cua_backend
+
+
+class _ExternalCuaSocket:
+    """The private daemon's transport interface, without runtime ownership.
+
+    An absolute Unix socket path is explicit opt-in. This adapter checks
+    liveness only and trusts the operator-controlled endpoint and immutable
+    launch policy; it does not attest runtime mode or manifest contents.
+    """
+
+    def __init__(self, socket_path: str, permission_mode: str, *, driver_cmd: str | None = None) -> None:
+        if (not isinstance(socket_path, str) or not socket_path
+                or "\x00" in socket_path or not os.path.isabs(socket_path)):
+            raise ValueError("computer_use.external_socket must be a non-empty absolute socket path")
+        configured_mode = str(_cb()._computer_use_cfg().get("permission_mode", "")).strip().lower()
+        if permission_mode == "unrestricted" or configured_mode == "unrestricted":
+            raise ValueError("computer_use.external_socket cannot be combined with YOLO/unrestricted mode")
+        self.socket_path = socket_path
+        self._driver_cmd = driver_cmd
+        self._command = ""
+
+    def child_env(self) -> dict[str, str]:
+        from tools.environments.local import _sanitize_subprocess_env
+        env = dict(_cb().cua_driver_child_env())
+        # The external daemon alone owns permission policy; never escalate it
+        # or pass the owned runtime's mode switches to a client process.
+        env.pop("CUA_DRIVER_PERMISSION_MODE", None)
+        env.pop("CUA_DRIVER_DANGEROUSLY_BYPASS_APPROVALS", None)
+        return _sanitize_subprocess_env(env)
+
+    def start(self) -> None:
+        self._command = ""
+        try:
+            if not stat.S_ISSOCK(os.lstat(self.socket_path).st_mode):
+                raise RuntimeError("not a Unix socket")
+            command = _driver.resolve_cua_driver_cmd(self._driver_cmd)
+            if not command:
+                raise RuntimeError(_driver.cua_driver_install_hint())
+            probe = _cb()._run_quiet(
+                [command, "status", "--socket", self.socket_path],
+                timeout=2.0, env=self.child_env())
+            if probe is None or probe.returncode != 0:
+                raise RuntimeError("external runtime did not answer status")
+        except (OSError, subprocess.SubprocessError, RuntimeError) as exc:
+            raise RuntimeError(f"computer_use.external_socket {self.socket_path!r} unavailable: {exc}") from exc
+        self._command = command
+
+    def proxy_invocation(self) -> tuple[str, list[str]]:
+        # Revalidate each MCP connection/reconnection for liveness only.
+        # --embedded itself prevents launch if the endpoint then disappears.
+        self.start()
+        return self._command, ["mcp", "--embedded", "--socket", self.socket_path]
+
+    def stop(self) -> None:
+        # Non-owning: no driver stop verb, process handle, signal or unlink.
+        self._command = ""
