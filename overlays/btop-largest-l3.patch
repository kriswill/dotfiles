+	//? CPUs sharing the largest L3, such as the 3D V-Cache CCD of an AMD X3D part. Empty when
+	//? every CPU's L3 is the same size, or sysfs has no cache information (not Linux).
+	vector<bool> largest_l3() {
+		namespace fs = std::filesystem;
+		vector<uint64_t> sizes(Shared::coreCount, 0);
+		for (const auto& n : iota(0, Shared::coreCount)) {
+			const fs::path cache = fmt::format("/sys/devices/system/cpu/cpu{}/cache", n);
+			for (int i = 0; fs::exists(cache / fmt::format("index{}", i)); i++) {
+				const auto index = cache / fmt::format("index{}", i);
+				if (readfile(index / "level") != "3") continue;
+				try { sizes[n] = std::stoull(readfile(index / "size", "0")); } catch (...) {}
+				break;
+			}
+		}
+		//? Offline CPUs have no cache directory; leave them out of the comparison.
+		uint64_t lo = 0, hi = 0;
+		for (const auto size : sizes) {
+			if (size == 0) continue;
+			lo = (lo == 0 ? size : min(lo, size));
+			hi = max(hi, size);
+		}
+		if (lo == hi) return {};
+		vector<bool> largest;
+		for (const auto size : sizes) largest.push_back(size == hi);
+		return largest;
+	}
