         }
 
         // Images the VT dropped entirely can go from the real terminal too.
-        let dropped: Vec<u32> = self
+        let dropped: Vec<TransmitKey> = self
             .transmitted
             .keys()
-            .filter(|id| graphics.image(**id).is_none())
