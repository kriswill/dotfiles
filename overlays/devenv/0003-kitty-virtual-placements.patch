             self.transmitted.insert(
-                image_id,
+                transmit_key,
                 Transmitted {
                     generation: *generation,
                 },
@@ -454,7 +528,8 @@ impl ImageSync {
 
         // New or moved placements.
         for (key, placement, _) in desired {
-            if !self.transmitted.contains_key(&key.0) {
+            let virtual_ = placement.kind == PlacementKind::Virtual;
+            if !self.transmitted.contains_key(&(key.0, virtual_)) {
                 continue;
             }
             let real_placement = match self.placed.get(&key) {
@@ -464,25 +539,30 @@ impl ImageSync {
                     stdout.write_all(delete_placement_command(current.image, id).as_bytes())?;
                     id
                 }
+                // Virtual placements keep the child's placement id: its
+                // placeholder cells may name it.
+                None if virtual_ => key.1,
