@@ -820,4 +904,85 @@ mod tests {
         assert!(sync.sync(&mut out, &vt, 0, 24).unwrap(), "nothing mirrored");
         assert!(String::from_utf8_lossy(&out).contains("a=p,q=2,C=1"));
     }
+
+    #[test]
+    fn virtual_placement_binds_by_the_childs_image_id() {
+        let p = Placement {
+            kind: PlacementKind::Virtual,
+            image: 7,
+            row: 0,
+            col: 0,
+            cols: 20,
+            rows: 8,
+            src: src(0, 0, 0, 0),
+            x_offset: 0,
+            y_offset: 0,
+            z: 0,
+        };
+        assert_eq!(place_command(0, &p), "\x1b_Ga=p,q=2,U=1,i=7,c=20,r=8\x1b\\");
+        assert_eq!(
+            place_command(3, &p),
+            "\x1b_Ga=p,q=2,U=1,i=7,p=3,c=20,r=8\x1b\\"
+        );
+        let bare = Placement {
+            cols: 0,
+            rows: 0,
+            ..p
+        };
+        assert_eq!(place_command(0, &bare), "\x1b_Ga=p,q=2,U=1,i=7\x1b\\");
+        assert_eq!(
+            delete_placement_command(7, 0),
+            "\x1b_Ga=d,d=i,q=2,i=7\x1b\\"
+        );
+        assert_eq!(terminal_image_id(7, true), 7);
+        assert_eq!(terminal_image_id(7, false), real_image_id(7));
+    }
+
+    /// yazi's protocol: `a=T,U=1` then placeholder cells. The VT stores a
+    /// virtual placement; the mirror must transmit under the child's id and
+    /// create a `U=1` placement for it, without touching the cursor.
+    #[test]
+    fn vt_virtual_placement_is_mirrored_under_the_childs_id() {
+        install_png_decoder();
+        let mut vt = Terminal::new(80, 24).expect("terminal");
+        vt.resize(80, 24, 9, 20).expect("cell size");
+        enable(&mut vt).expect("enable");
+        vt.vt_write(
+            format!("\x1b_Ga=T,q=2,C=1,U=1,f=100,i=7,c=2,r=1;{ONE_PIXEL_PNG_B64}\x1b\\").as_bytes(),
+        );
+        // Placeholder cells: fg colour = image id 7, U+10EEEE + row/col marks.
+        vt.vt_write(
+            "\x1b[38;2;0;0;7m\u{10EEEE}\u{0305}\u{0305}\u{10EEEE}\u{0305}\u{030D}\x1b[0m"
+                .as_bytes(),
+        );
+
+        let mut sync = ImageSync::default();
+        let mut out = Vec::new();
+        assert!(sync.sync(&mut out, &vt, 0, 24).unwrap());
+        let text = String::from_utf8_lossy(&out).to_string();
+        assert!(
+            text.contains("\x1b_Ga=t,t=d,q=2,i=7,f=32,s=1,v=1,m=0;"),
+            "{text:?}"
+        );
+        assert!(
+            text.contains("\x1b_Ga=p,q=2,U=1,i=7,c=2,r=1\x1b\\"),
+            "{text:?}"
+        );
+        assert!(
+            !text.contains("\x1b["),
+            "virtual placements must not move the cursor: {text:?}"
+        );
+
+        // Steady state.
+        let mut out = Vec::new();
+        assert!(!sync.sync(&mut out, &vt, 0, 24).unwrap());
+
+        // Deleting the placement in the VT deletes it on the real terminal.
+        // (yazi's `d=A` only covers cell-visible placements in libghostty;
+        // a virtual placement whose cells are repainted shows nothing anyway.)
+        vt.vt_write(b"\x1b_Gq=2,a=d,d=i,i=7\x1b\\");
+        let mut out = Vec::new();
+        assert!(sync.sync(&mut out, &vt, 0, 24).unwrap());
+        assert_eq!(String::from_utf8_lossy(&out), "\x1b_Ga=d,d=i,q=2,i=7\x1b\\");
+    }
 }
