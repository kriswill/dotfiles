From 4f9426011718846af74adfb8651e52be6c2679a1 Mon Sep 17 00:00:00 2001
From: Kris Williams <115474+kriswill@users.noreply.github.com>
Date: Thu, 10 Sep 2026 19:06:29 -0700
Subject: [PATCH] devenv-shell: mirror Unicode-placeholder (virtual) kitty
 placements

yazi (and other `U=1` users) transmit the image with a virtual placement
and draw placeholder cells whose foreground colour carries the image id.
The row renderer already copies those cells to the real terminal; what was
missing is the image itself and a virtual placement for it there. Mirror
virtual placements by transmitting the image under the CHILD's own id
(the cells reference it, so it cannot be remapped) and issuing
`a=p,U=1` with the child's placement id and c/r, no cursor movement.
---
 devenv-shell/src/kitty_images.rs | 233 ++++++++++++++++++++++++++-----
 1 file changed, 199 insertions(+), 34 deletions(-)

diff --git a/devenv-shell/src/kitty_images.rs b/devenv-shell/src/kitty_images.rs
index d74d3b1f..8b565cfb 100644
--- a/devenv-shell/src/kitty_images.rs
+++ b/devenv-shell/src/kitty_images.rs
@@ -132,12 +132,29 @@ fn real_image_id(vt_image_id: u32) -> u32 {
     REAL_ID_BASE | (vt_image_id & REAL_ID_MASK)
 }
 
+/// How a placement is anchored on the real terminal.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum PlacementKind {
+    /// Pinned to grid cells: placed at an explicit cursor position under the
+    /// private image id range.
+    Pinned,
+    /// Unicode-placeholder placement (`U=1`, used by yazi and others): the
+    /// image is bound to placeholder cells whose foreground colour carries
+    /// the CHILD's image id. The row renderer already copies those cells, so
+    /// the real terminal must hold the image under that same id and a
+    /// virtual placement for it. Ids therefore go through unmapped.
+    Virtual,
+}
+
 /// One placement as it should appear on the real terminal.
 #[derive(Clone, Debug, PartialEq, Eq)]
 struct Placement {
+    kind: PlacementKind,
+    /// Image id on the real terminal (`real_image_id` for pinned, the child's
+    /// own id for virtual).
     image: u32,
     /// Real-terminal row/column (already offset by the renderer's takeover
-    /// offset and clipped to the content area).
+    /// offset and clipped to the content area). Unused for virtual.
     row: u16,
     col: u16,
     cols: u32,
@@ -243,9 +260,25 @@ fn transmit_commands(
     out
 }
 
-/// `a=p` placement at the cursor. `C=1` keeps the real cursor where the
-/// renderer put it.
+/// `a=p` placement. Pinned placements go at the cursor with `C=1` so the
+/// real cursor stays where the renderer put it; virtual ones bind to the
+/// placeholder cells by image id (the child's placement id, when it gave
+/// one, is what its cells may reference).
 fn place_command(real_placement: u32, p: &Placement) -> String {
+    if p.kind == PlacementKind::Virtual {
+        let mut cmd = format!("\x1b_Ga=p,q=2,U=1,i={}", p.image);
+        if real_placement != 0 {
+            cmd.push_str(&format!(",p={real_placement}"));
+        }
+        if p.cols != 0 {
+            cmd.push_str(&format!(",c={}", p.cols));
+        }
+        if p.rows != 0 {
+            cmd.push_str(&format!(",r={}", p.rows));
+        }
+        cmd.push_str("\x1b\\");
+        return cmd;
+    }
     format!(
         "\x1b_Ga=p,q=2,C=1,i={},p={},c={},r={},x={},y={},w={},h={},X={},Y={},z={}\x1b\\",
         p.image,
@@ -262,8 +295,13 @@ fn place_command(real_placement: u32, p: &Placement) -> String {
     )
 }
 
-/// Delete one placement, keeping the image data for reuse.
+/// Delete one placement, keeping the image data for reuse. A zero placement
+/// id (an id-less virtual placement) deletes the image's placements as a
+/// whole, which is all the protocol offers for it.
 fn delete_placement_command(real_image: u32, real_placement: u32) -> String {
+    if real_placement == 0 {
+        return format!("\x1b_Ga=d,d=i,q=2,i={real_image}\x1b\\");
+    }
     format!("\x1b_Ga=d,d=i,q=2,i={real_image},p={real_placement}\x1b\\")
 }
 
@@ -281,13 +319,25 @@ struct Transmitted {
     generation: u64,
 }
 
+/// Images are transmitted per (VT image id, unmapped?) — pinned placements
+/// use the private id range, virtual ones the child's id.
+type TransmitKey = (u32, bool);
+
+fn terminal_image_id(image_id: u32, raw: bool) -> u32 {
+    if raw {
+        image_id
+    } else {
+        real_image_id(image_id)
+    }
+}
+
 /// Mirrors the VT's kitty placements onto the real terminal.
 #[derive(Default)]
 pub struct ImageSync {
     iterator: Option<PlacementIterator<'static>>,
-    /// VT image id → what the real terminal currently holds under
-    /// `real_image_id(id)`.
-    transmitted: HashMap<u32, Transmitted>,
+    /// What the real terminal currently holds, per VT image id and id
+    /// mapping (see `TransmitKey`).
+    transmitted: HashMap<TransmitKey, Transmitted>,
     /// Placements currently shown on the real terminal, with their real
     /// placement ids.
     placed: HashMap<PlacementKey, (u32, Placement)>,
@@ -335,11 +385,6 @@ impl ImageSync {
             let mut placements = iterator.update(&graphics).map_err(vt_err)?;
             placements.set_layer(Layer::All).map_err(vt_err)?;
             while let Some(placement) = placements.next() {
-                // Unicode-placeholder placements render through text cells
-                // the row renderer already copies; nothing to mirror.
-                if placement.is_virtual().unwrap_or(false) {
-                    continue;
-                }
                 let (Ok(image_id), Ok(placement_id)) =
                     (placement.image_id(), placement.placement_id())
                 else {
@@ -348,6 +393,34 @@ impl ImageSync {
                 let Some(image) = graphics.image(image_id) else {
                     continue;
                 };
+                let ordinal = ordinals.entry((image_id, placement_id)).or_insert(0);
+                let key = (image_id, placement_id, *ordinal);
