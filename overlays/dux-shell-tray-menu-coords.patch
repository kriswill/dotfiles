+    // mapToGlobal() places a layer-shell window at its screen's origin, since a
+    // Wayland client is never told where the compositor put it. A bar on the
+    // bottom or right edge is really offset by the screen size minus its own.
+    function screenPointFor(item, x, y) {
+        const gp = item.mapToGlobal(x, y);
+        const win = item.Window.window;
+        const screen = root.parentScreen;
+        if (!win || !screen)
+            return gp;
+        const edge = root.axis?.edge;
+        if (edge === "bottom")
+            return Qt.point(gp.x, gp.y + Math.max(0, screen.height - win.height));
+        if (edge === "right")
+            return Qt.point(gp.x + Math.max(0, screen.width - win.width), gp.y);
+        return gp;
+    }
