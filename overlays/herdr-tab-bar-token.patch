+// Green→yellow→red gradient across the bar's extent, matching dotbar's
+// dense palette; empty cells stay a neutral dark gray.
+fn bar_cell_color(cell: usize) -> Color {
+    let t = (cell as f64 + 0.5) / BAR_CELLS as f64;
+    if t < 0.5 {
+        Color::Rgb((510.0 * t).round().min(255.0) as u8, 255, 0)
+    } else {
+        Color::Rgb(255, (255.0 - 510.0 * (t - 0.5)).round().max(0.0) as u8, 0)
+    }
+}
+
+fn bar_line(pct: f64, label: &str, bg: Color, label_fg: Color) -> Line<'static> {
+    let mut spans = Vec::with_capacity(BAR_CELLS + 1);
+    for cell in 0..BAR_CELLS {
+        let fill = ((pct / 100.0) * BAR_CELLS as f64 - cell as f64).clamp(0.0, 1.0);
+        let eighths = (fill * 8.0).round() as usize;
+        let (glyph, fg) = if eighths == 0 {
+            (BAR_EMPTY_GLYPH, Color::Rgb(60, 60, 60))
+        } else {
+            (BAR_FILL_GLYPHS[eighths.min(8) - 1], bar_cell_color(cell))
+        };
+        spans.push(Span::styled(
+            glyph.to_string(),
+            Style::default().fg(fg).bg(bg),
+        ));
+    }
+    spans.push(Span::styled(
+        format!(" {label}"),
+        Style::default()
+            .fg(label_fg)
+            .bg(bg)
+            .add_modifier(Modifier::DIM),
+    ));
+    Line::from(spans)
+}
